# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.
#
# Restart `npm run dev` after changing these.

# ---------------------------------------------------------------------------
# Contact form delivery (app/api/contact/route.ts)
# ---------------------------------------------------------------------------

# Required for the form to actually send email.
# Get a free key at https://resend.com -> API Keys.
RESEND_API_KEY=

# Where contact messages are delivered.
# Optional — defaults to the `email` in data/profile.ts.
CONTACT_TO_EMAIL=

# The address messages are sent FROM.
# Optional — defaults to "Portfolio Contact <onboarding@resend.dev>", Resend's
# shared test sender. That default can only deliver to the email address you
# registered with Resend. To receive at any other address, verify your own
# domain in Resend and use an address on it, e.g.:
#   CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
